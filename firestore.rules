rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['billing']);

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'name',
          'avatar',
          'occupation',
          'userPreferences',
          'memories',
          'memoryEnabled',
          'updatedAt'
        ])
        && (
          (
            !resource.data.keys().hasAny(['billing'])
            && !request.resource.data.keys().hasAny(['billing'])
          )
          || request.resource.data.billing == resource.data.billing
        );

      allow delete: if false;

      match /creditUsage/{dateId} {
        allow read, write: if false;
      }

      match /mcpServers/{serverId} {
        allow read, write: if false;
      }

      match /helpers/{helperId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /threads/{threadId} {
      allow read: if (
        signedIn() && resource.data.userId == request.auth.uid
      ) || (
        resource.data.shareId is string
        && resource.data.shareId.size() > 0
      );
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /helpers/{helperId} {
      allow read: if resource.data.status == 'published'
        || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
    }

    match /promptLinks/{linkId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /waitlist/{entryId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /scheduledTasks/{taskId} {
      allow read, write: if false;
    }

    match /scheduledTaskRuns/{runId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
