NEXT_PUBLIC_BASE_URL=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK service account (server-only). Either the raw service
# account JSON or its base64 encoding. Used for ID token verification and
# server-side Firestore reads. Falls back to GOOGLE_APPLICATION_CREDENTIALS
# (application default credentials) if unset.
FIREBASE_SERVICE_ACCOUNT=


OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
COMPOSIO_API_KEY=

GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Public app URL used by QStash callbacks. In local development this must be a
# public tunnel URL if you want real scheduled triggers to reach your machine.
APP_URL=

# Upstash QStash scheduling.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Razorpay Subscriptions. Use Test Mode values locally/staging and Live Mode
# values only in the production environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional during webhook-secret rotation. Remove after Razorpay is fully
# switched to RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_PLUS_MONTHLY_PLAN_ID=
RAZORPAY_PLUS_ANNUAL_PLAN_ID=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_ANNUAL_PLAN_ID=

# Secret used by the scheduler that calls POST /api/billing/refresh-credits.
BILLING_CRON_SECRET=
# On Vercel, set CRON_SECRET to the same value so scheduled GET requests carry it.
CRON_SECRET=

# Keep the Cloudflare tunnel token outside package.json/source control.
CLOUDFLARED_TUNNEL_TOKEN=
